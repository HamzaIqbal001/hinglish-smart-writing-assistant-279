# Environment Configuration for Hinglish Smart Writing Assistant

# Hugging Face Access Token
# Required if directly loading gated checkpoints (e.g. ai4bharat/indictrans2-indic-en-dist-200M)
# If left empty, the pipeline automatically falls back to verified open mirrors and offline weights.
HF_TOKEN=

# Optional LLM API keys (if swapping out local instruct models for API endpoints)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
